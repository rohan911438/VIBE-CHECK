{
  "version": 2,
  "name": "vibe-check",
  "builds": [
    {
      "src": "mental-health-tracker/**",
      "use": "@vercel/static"
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "(.*)",
      "dest": "mental-health-tracker/index.html"
    }
  ]
}
